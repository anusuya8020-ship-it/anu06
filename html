<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A. Anusuya — Python Developer &amp; Prompt Engineer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#100c22;
    --bg-alt:#161030;
    --surface:#1d1740;
    --surface-line:#332a63;
    --violet:#7c5cff;
    --teal:#45e0c0;
    --text:#f2f0fa;
    --muted:#a79fc9;
    --mono:'JetBrains Mono', monospace;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter', sans-serif;
    overflow-x:hidden;
  }
  h1,h2,h3{font-family:'Sora', sans-serif;}

  /* circuit trace divider */
  .trace{
    position:relative;
    height:2px;
    width:100%;
    background:linear-gradient(90deg, transparent, var(--violet), var(--teal), transparent);
    opacity:.5;
  }

  /* nav */
  nav{
    position:sticky;
    top:0;
    z-index:50;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:20px 6vw;
    background:rgba(16,12,34,0.85);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--surface-line);
  }
  .logo{
    font-family:var(--mono);
    font-size:.95rem;
    color:var(--teal);
    letter-spacing:.5px;
  }
  .logo span{color:var(--violet);}
  .nav-links{
    display:flex;
    gap:34px;
    list-style:none;
  }
  .nav-links a{
    color:var(--muted);
    text-decoration:none;
    font-size:.92rem;
    font-weight:500;
    transition:color .2s;
    position:relative;
  }
  .nav-links a:hover, .nav-links a:focus-visible{color:var(--text);}
  .nav-links a::after{
    content:"";
    position:absolute;
    left:0; bottom:-6px;
    width:0; height:2px;
    background:linear-gradient(90deg,var(--violet),var(--teal));
    transition:width .25s;
  }
  .nav-links a:hover::after, .nav-links a:focus-visible::after{width:100%;}
  .nav-toggle{display:none;}

  /* section label — terminal comment motif */
  .eyebrow{
    font-family:var(--mono);
    font-size:.85rem;
    color:var(--teal);
    margin-bottom:14px;
    display:flex;
    align-items:center;
    gap:10px;
  }
  .eyebrow::before{content:"//";color:var(--violet);}

  section{
    padding:110px 6vw;
    max-width:1180px;
    margin:0 auto;
  }

  /* HERO */
  .hero{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    align-items:center;
    gap:60px;
    padding-top:90px;
    min-height:88vh;
  }
  .hero-copy .eyebrow{margin-bottom:22px;}
  .hero h1{
    font-size:clamp(2.4rem, 5vw, 4rem);
    line-height:1.08;
    font-weight:800;
    margin-bottom:18px;
  }
  .hero h1 .accent{
    background:linear-gradient(90deg,var(--violet),var(--teal));
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
  }
  .hero .role{
    font-family:var(--mono);
    font-size:1.05rem;
    color:var(--muted);
    margin-bottom:34px;
  }
  .hero .role .bar{
    display:inline-block;
    width:10px;height:1.1em;
    background:var(--teal);
    vertical-align:-2px;
    margin-left:4px;
    animation:blink 1.1s step-end infinite;
  }
  @keyframes blink{50%{opacity:0;}}
  .btn-row{display:flex;gap:16px;flex-wrap:wrap;}
  .btn{
    font-family:var(--mono);
    font-size:.88rem;
    padding:13px 26px;
    border-radius:8px;
    text-decoration:none;
    font-weight:500;
    transition:transform .2s, box-shadow .2s;
  }
  .btn-primary{
    background:linear-gradient(90deg,var(--violet),var(--teal));
    color:#0d0a1f;
  }
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(124,92,255,.35);}
  .btn-ghost{
    border:1px solid var(--surface-line);
    color:var(--text);
  }
  .btn-ghost:hover{border-color:var(--teal);color:var(--teal);}

  .hero-photo-wrap{
    position:relative;
    justify-self:center;
  }
  .hero-photo-frame{
    width:320px;
    height:380px;
    border-radius:18px;
    overflow:hidden;
    position:relative;
    border:1px solid var(--surface-line);
    box-shadow:0 30px 60px -20px rgba(124,92,255,.35);
  }
  .hero-photo-frame img{
    width:100%;height:100%;object-fit:cover;display:block;
  }
  .hero-photo-frame::after{
    content:"";
    position:absolute;inset:0;
    background:linear-gradient(180deg, transparent 60%, rgba(16,12,34,.55));
  }
  .tag-chip{
    position:absolute;
    bottom:-18px;
    left:-24px;
    background:var(--surface);
    border:1px solid var(--surface-line);
    padding:10px 16px;
    border-radius:10px;
    font-family:var(--mono);
    font-size:.78rem;
    color:var(--teal);
    box-shadow:0 10px 30px rgba(0,0,0,.4);
  }

  /* ABOUT */
  .about{
    display:grid;
    grid-template-columns:.4fr .6fr;
    gap:60px;
    align-items:start;
  }
  .about h2{font-size:2.2rem;font-weight:700;}
  .about p{
    font-size:1.15rem;
    line-height:1.75;
    color:var(--muted);
  }
  .about-stats{
    display:grid;
    gap:18px;
    margin-top:30px;
  }
  .stat{
    border:1px solid var(--surface-line);
    border-radius:12px;
    padding:18px 20px;
    background:var(--surface);
  }
  .stat b{
    display:block;
    font-family:var(--mono);
    color:var(--teal);
    font-size:1.4rem;
  }
  .stat span{color:var(--muted);font-size:.85rem;}

  /* SKILLS */
  .skills-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(190px,1fr));
    gap:16px;
    margin-top:36px;
  }
  .skill-card{
    border:1px solid var(--surface-line);
    background:var(--surface);
    border-radius:14px;
    padding:26px 22px;
    transition:transform .25s, border-color .25s;
  }
  .skill-card:hover{
    transform:translateY(-4px);
    border-color:var(--violet);
  }
  .skill-card .n{
    font-family:var(--mono);
    color:var(--violet);
    font-size:.78rem;
    display:block;
    margin-bottom:10px;
  }
  .skill-card h3{font-size:1.05rem;font-weight:600;}

  /* PROJECTS */
  .projects-list{
    margin-top:36px;
    display:flex;
    flex-direction:column;
  }
  .project-row{
    display:grid;
    grid-template-columns:70px 1fr auto;
    align-items:center;
    gap:24px;
    padding:26px 8px;
    border-bottom:1px solid var(--surface-line);
    text-decoration:none;
    transition:padding-left .25s, background .25s;
  }
  .project-row:hover{
    padding-left:18px;
    background:linear-gradient(90deg, rgba(124,92,255,.08), transparent);
  }
  .project-row .idx{
    font-family:var(--mono);
    color:var(--muted);
    font-size:.85rem;
  }
  .project-row h3{
    font-size:1.25rem;
    font-weight:600;
    color:var(--text);
  }
  .project-row .arrow{
    color:var(--teal);
    font-size:1.3rem;
    opacity:0;
    transform:translateX(-6px);
    transition:opacity .25s, transform .25s;
  }
  .project-row:hover .arrow{opacity:1;transform:translateX(0);}

  /* INTERNSHIP */
  .intern-strip{
    display:flex;
    flex-wrap:wrap;
    gap:18px;
    margin-top:36px;
  }
  .intern-pill{
    font-family:var(--mono);
    font-size:.95rem;
    padding:16px 24px;
    border-radius:999px;
    border:1px solid var(--surface-line);
    background:var(--surface);
    color:var(--text);
    position:relative;
    padding-left:38px;
  }
  .intern-pill::before{
    content:"";
    position:absolute;
    left:18px; top:50%;
    width:8px;height:8px;
    border-radius:50%;
    background:var(--teal);
    transform:translateY(-50%);
    box-shadow:0 0 10px var(--teal);
  }

  footer{
    text-align:center;
    padding:50px 6vw 70px;
    color:var(--muted);
    font-family:var(--mono);
    font-size:.85rem;
  }

  @media(max-width:860px){
    .nav-links{display:none;}
    .hero{grid-template-columns:1fr;text-align:center;padding-top:60px;}
    .hero-photo-wrap{order:-1;}
    .hero .btn-row{justify-content:center;}
    .about{grid-template-columns:1fr;}
    .project-row{grid-template-columns:50px 1fr;}
    .project-row .arrow{display:none;}
  }
  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    .hero .role .bar{animation:none;}
    *{transition:none !important;}
  }
</style>
</head>
